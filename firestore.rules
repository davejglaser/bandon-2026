rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone with the trip link can read and edit that one trip; nobody can list or delete trips.
    match /trips/{trip} {
      allow get, create, update: if true;
      allow list, delete: if false;
      match /expenses/{expense} {
        allow read, write: if true;
      }
    }
  }
}
